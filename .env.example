# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=vss
POSTGRES_USER=vss
POSTGRES_PASSWORD=vss         # ganti di production

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error

# ── Project Management Web UI ─────────────────────────────────────────────────
AUTH_SECRET=                  # WAJIB — buat dengan: openssl rand -base64 32

# ── INSW / LARTAS Gateway ─────────────────────────────────────────────────────
LARTAS_BASE_URL=https://api.insw.go.id
INSW_CLIENT_ID=
INSW_CLIENT_BEARER=
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
INSW_API_KEY=                 # opsional — mengamankan endpoint /lartas
INSW_ADMIN_KEY=               # opsional — mengamankan endpoint /admin/token
