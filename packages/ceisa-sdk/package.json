{
  "name": "@pesisir/ceisa-sdk",
  "description": "CEISA 4.0 SDK and Pi tools for local BC 2.3 drafts and read-only status/kurs checks.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions"]
  },
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "login": "bun run index.ts",
    "lartas": "bun run lartas.ts",
    "kurs": "bun run kurs.ts",
    "aju": "bun run aju.ts",
    "schemas:extract": "bun run scripts/extract-schemas.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "smoke:read": "bun run scripts/smoke-readonly.ts"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "typescript": "^5"
  }
}
